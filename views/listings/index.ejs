<% layout("/layouts/boilerplate") %>

<!-- <h3>All Listings</h3> -->
<style>
  #filters {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    margin-top: 20px;
    margin-bottom: 20px;
  }

  .filter {
    text-align: center;
    padding: 10px 15px;
    border: 1px solid #ccc;
    border-radius: 20px;
    cursor: pointer;
    transition: background-color 0.3s, color 0.3s;
  }

  .filter:hover {
    background-color: #007bff;
    color: white;
  }


  .tax-info {
    display: none;
    font-size: 0.9em;
    color: gray;
  }

  .tax-toggle {
    margin-left: auto;
    align-self: center;
    border: 1px solid black;
    padding: 5px 10px;
    border-radius: 20px;
  }
  </style>

<div id="filters">
  <div class="filter">
   <div> <i class="fa-solid fa-fire"></i> </div>  
    <p><b>Trending</b></p>

  </div>  
  <div class="filter">
    <div> <i class="fa-solid fa-bed"></i> </div>  
    <p><b>Rooms</b></p>

  </div>
  <div class="filter">
    <div> <i class="fa-solid fa-mountain-city"></i> </div>  
    <p><b>City</b></p>

  </div>
  <div class="filter">
    <div> <i class="fa-solid fa-fort-awesome"></i> </div>  
    <p><b>castle</b></p>
  </div>
  <div class="filter">
    <div> <i class="fa-solid fa-campground"></i> </div>  
    <p><b>Camping</b></p>  
  </div>

  <div class="filter">
    <div> <i class="fa-solid fa-person-swimming"></i> </div>  
    <p><b>Swimming</b></p>
  </div>
  <div class="filter">
    <div> <i class="fa-solid fa-cow"></i> </div>  
    <p><b>Farms</b></p>
  </div>  

    <div class="filter">
      <div> <i class="fa-solid fa-skiing-nordic"></i> </div>  
      <p><b>Skiing</b></p>
    </div>
  

  <div class="filter">
    <div> <i class="fa-solid fa-igloo"></i> </div>  
    <p><b>Domes</b></p>
  </div>

  <div class="tax-toggle">
    <div class="form-check-reverse form-switch">
      <input class="form-check-input" 
      type="checkbox"
      role="switch" 
      id="flexSwitchCheckDefault">
      <label class="form-check-label" for="flexSwitchCheckDefault"
      >Display Taxes</label> 
    </div>
  </div>
  


</div>   



<div class="row row-cols-lg-3" row-cols-md-2 row-cols-sm-1 mt-3>
  <% for (let listing of allListings) { %>

    <a href="/listings/<%= listing._id %>" style="text-decoration: none; color: black;">    
      <div class="card col listing-card mb-4">

        <img 
          src="<%= listing.image?.url || 'https://via.placeholder.com/300x200' %>" 
          class="card-img-top"
          alt="listing_image"
          style="height: 200px; object-fit: cover;"
        />

        <div class="card-body">
          <p class="card-text">
            <b><%= listing.title %></b><br>
            $<%= listing.price.toLocaleString("en-IN") %> per night
            <i class="tax-info"> &nbsp; &nbsp;+18% GST </i>
          </p>
        </div>

      </div>
    </a>

  <% } %>
</div>

    
     


    <!-- <div class="card" style="width: 18rem;">
  <img src="..." class="card-img-top" alt="...">
  <div class="card-body">
    <p class="card-text">Some quick example text to build on the card title and make up the bulk of the card’s content.</p>
  </div>
</div> -->

<script>
  const taxToggle = document.getElementById('flexSwitchCheckDefault');

  taxToggle.addEventListener("click", () => {
    const taxInfo = document.getElementsByClassName('tax-info');
    for (info of taxInfo) {
      if (taxToggle.checked) {
        info.style.display = 'inline';
      } else {
        info.style.display = 'none';
      }
    }
  });
</script>  
    